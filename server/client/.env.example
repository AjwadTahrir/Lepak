# Copy to .env (never commit .env). Restart `npm run dev` after changing it.

# Production only: the deployed API origin, e.g. https://lepak-api.onrender.com
# Leave empty in development: Vite proxies /api to VITE_PROXY_TARGET.
VITE_API_URL=

# Dev proxy target (defaults to http://localhost:5000)
VITE_PROXY_TARGET=http://localhost:5000

# Supabase, PUBLISHABLE key only (never the sb_secret_ key). Needed for sign-in; browsing works without it.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# true = use the sample data in src/data/mock instead of the API
VITE_USE_MOCK=false
